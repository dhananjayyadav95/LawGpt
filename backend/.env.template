# Nepal Law Assistant - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# AI Provider Configuration (choose one)
AI_PROVIDER=google
AI_MODEL=gemini-pro

# API Keys (get free keys from respective providers)
GOOGLE_API_KEY=your-google-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
EMERGENT_LLM_KEY=your-emergent-llm-key-here

# Database Configuration
MONGO_URL=mongodb://localhost:27017/nepal_law
DB_NAME=nepal_law_db

# Server Configuration
CORS_ORIGINS=http://localhost:3000

# Optional: OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract